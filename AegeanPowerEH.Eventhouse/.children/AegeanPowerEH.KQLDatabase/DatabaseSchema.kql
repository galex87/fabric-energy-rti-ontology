.create-merge table EmissionsStream (timestamp:datetime, stream_type:string, plant_id:string, plant_name:string, power_output_mw:real, co2_kg_per_hour:real, cumulative_co2_tonnes_today:real, ets_daily_allowance_tonnes:real, compliance_pct:real, fuel_type:string, fault_type:string) 
.create-or-alter table EmissionsStream ingestion json mapping 'AutoMapping'
```
[{"Properties":{"Path":"$.timestamp"},"column":"timestamp","datatype":""},{"Properties":{"Path":"$.stream_type"},"column":"stream_type","datatype":""},{"Properties":{"Path":"$.plant_id"},"column":"plant_id","datatype":""},{"Properties":{"Path":"$.plant_name"},"column":"plant_name","datatype":""},{"Properties":{"Path":"$.power_output_mw"},"column":"power_output_mw","datatype":""},{"Properties":{"Path":"$.co2_kg_per_hour"},"column":"co2_kg_per_hour","datatype":""},{"Properties":{"Path":"$.cumulative_co2_tonnes_today"},"column":"cumulative_co2_tonnes_today","datatype":""},{"Properties":{"Path":"$.ets_daily_allowance_tonnes"},"column":"ets_daily_allowance_tonnes","datatype":""},{"Properties":{"Path":"$.compliance_pct"},"column":"compliance_pct","datatype":""},{"Properties":{"Path":"$.fuel_type"},"column":"fuel_type","datatype":""},{"Properties":{"Path":"$.fault_type"},"column":"fault_type","datatype":""}]
```
.create-or-alter function with (skipvalidation = "true") VesselTracking() {
    VesselPositions | where timestamp > ago(5s) | summarize arg_max(timestamp, *) by vessel_id | extend marker_size = 30 | project vessel_id, vessel_name, vessel_type, latitude, longitude, speed_knots, heading_deg, destination, eta_hours, cargo_status, marker_size, timestamp
}
.create-or-alter function with (skipvalidation = "true") WindFarmsLive() { WindTurbineTelemetry | where timestamp > ago(15s) | summarize arg_max(timestamp, *) by turbine_id | project turbine_id, latitude, longitude, power_mw, vibration_mm_s, wind_speed_ms, fault_type, region = case(turbine_id startswith 'WT-THR','Thrace', turbine_id startswith 'WT-TIN','Tinos','Naxos'), severity = case(fault_type == 'DEMO_FORCED_FAILURE', 'OFFLINE', vibration_mm_s > 7.0, 'CRITICAL', vibration_mm_s > 5.0, 'WARNING', 'OK'), bubble_size = case(fault_type == 'DEMO_FORCED_FAILURE', 12, max_of(toint(power_mw * 2), 2)), timestamp }
.create-or-alter function with (skipvalidation = "true") SolarParksLive() { SolarInverterTelemetry | where timestamp > ago(30s) | summarize arg_max(timestamp, *) by inverter_id | project inverter_id, latitude, longitude, power_kw, efficiency_pct, panel_temp_c, park = case(inverter_id startswith 'SI-THE','Thessaly','Crete'), bubble_size = max_of(toint(power_kw / 800), 2), timestamp }
.create-or-alter function with (skipvalidation = "true") GasPlantsLive() { let coords = datatable(plant_id:string, latitude:real, longitude:real)[ 'PP-LAV-01', 37.72, 24.05, 'PP-MEG-01', 37.40, 22.14 ]; EmissionsStream | where timestamp > ago(60s) | summarize arg_max(timestamp, *) by plant_id | join kind=leftouter coords on plant_id | project plant_id, plant_name, latitude, longitude, power_output_mw, co2_kg_per_hour, compliance_pct, bubble_size = 8, timestamp }
.create-or-alter materialized-view  VesselTrackingMV on table VesselPositions { VesselPositions | summarize arg_max(timestamp, vessel_name, vessel_type, latitude, longitude, speed_knots, heading_deg, destination, eta_hours, cargo_status) by vessel_id }
.create-or-alter materialized-view  TurbineLatestMV on table WindTurbineTelemetry { WindTurbineTelemetry | summarize arg_max(timestamp, power_mw, vibration_mm_s, wind_speed_ms, rotor_rpm, nacelle_temp_c, latitude, longitude) by turbine_id }
.alter table WindTurbineTelemetry policy retention @'{"SoftDeletePeriod":"90.00:00:00","Recoverability":"Enabled"}'
.alter table WindTurbineTelemetry policy streamingingestion "{\"IsEnabled\":true,\"HintAllocatedRate\":null,\"NumberOfRowStores\":null,\"SealIntervalLimit\":null,\"SealThresholdBytes\":null,\"UsageTags\":[],\"IsMaintenanceActive\":false}"
.alter table SolarInverterTelemetry policy streamingingestion "{\"IsEnabled\":true,\"HintAllocatedRate\":null,\"NumberOfRowStores\":null,\"SealIntervalLimit\":null,\"SealThresholdBytes\":null,\"UsageTags\":[],\"IsMaintenanceActive\":false}"
.alter table GridTelemetry policy streamingingestion "{\"IsEnabled\":true,\"HintAllocatedRate\":null,\"NumberOfRowStores\":null,\"SealIntervalLimit\":null,\"SealThresholdBytes\":null,\"UsageTags\":[],\"IsMaintenanceActive\":false}"
.alter table VesselPositions policy streamingingestion "{\"IsEnabled\":true,\"HintAllocatedRate\":null,\"NumberOfRowStores\":null,\"SealIntervalLimit\":null,\"SealThresholdBytes\":null,\"UsageTags\":[],\"IsMaintenanceActive\":false}"
.alter table EmissionsStream policy streamingingestion "{\"IsEnabled\":true,\"HintAllocatedRate\":null,\"NumberOfRowStores\":null,\"SealIntervalLimit\":null,\"SealThresholdBytes\":null,\"UsageTags\":[],\"IsMaintenanceActive\":false}"
