.create-merge table VesselPositions (timestamp:datetime, stream_type:string, vessel_id:string, vessel_name:string, vessel_type:string, latitude:real, longitude:real, speed_knots:real, heading_deg:real, destination:string, eta_hours:real, cargo_status:string) 
.create-or-alter table VesselPositions ingestion json mapping 'AutoMapping'
```
[{"Properties":{"Path":"$.timestamp"},"column":"timestamp","datatype":""},{"Properties":{"Path":"$.stream_type"},"column":"stream_type","datatype":""},{"Properties":{"Path":"$.vessel_id"},"column":"vessel_id","datatype":""},{"Properties":{"Path":"$.vessel_name"},"column":"vessel_name","datatype":""},{"Properties":{"Path":"$.vessel_type"},"column":"vessel_type","datatype":""},{"Properties":{"Path":"$.latitude"},"column":"latitude","datatype":""},{"Properties":{"Path":"$.longitude"},"column":"longitude","datatype":""},{"Properties":{"Path":"$.speed_knots"},"column":"speed_knots","datatype":""},{"Properties":{"Path":"$.heading_deg"},"column":"heading_deg","datatype":""},{"Properties":{"Path":"$.destination"},"column":"destination","datatype":""},{"Properties":{"Path":"$.eta_hours"},"column":"eta_hours","datatype":""},{"Properties":{"Path":"$.cargo_status"},"column":"cargo_status","datatype":""}]
