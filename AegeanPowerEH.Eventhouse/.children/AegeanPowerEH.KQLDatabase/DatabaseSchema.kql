// KQL script
// Use management commands in this script to configure your database items, such as tables, functions, materialized views, and more.


.create-merge table WindTurbineTelemetry (timestamp:datetime, stream_type:string, turbine_id:string, plant_id:string, power_mw:real, wind_speed_ms:real, vibration_mm_s:real, rotor_rpm:real, nacelle_temp_c:real, latitude:real, longitude:real, fault_type:string) 
.create-merge table SolarInverterTelemetry (timestamp:datetime, stream_type:string, inverter_id:string, plant_id:string, power_kw:real, irradiance_wm2:real, panel_temp_c:real, efficiency_pct:real, latitude:real, longitude:real, fault_type:string) 
.create-or-alter table SolarInverterTelemetry ingestion json mapping 'AutoMapping'
```
[{"Properties":{"Path":"$.timestamp"},"column":"timestamp","datatype":""},{"Properties":{"Path":"$.stream_type"},"column":"stream_type","datatype":""},{"Properties":{"Path":"$.inverter_id"},"column":"inverter_id","datatype":""},{"Properties":{"Path":"$.plant_id"},"column":"plant_id","datatype":""},{"Properties":{"Path":"$.power_kw"},"column":"power_kw","datatype":""},{"Properties":{"Path":"$.irradiance_wm2"},"column":"irradiance_wm2","datatype":""},{"Properties":{"Path":"$.panel_temp_c"},"column":"panel_temp_c","datatype":""},{"Properties":{"Path":"$.efficiency_pct"},"column":"efficiency_pct","datatype":""},{"Properties":{"Path":"$.latitude"},"column":"latitude","datatype":""},{"Properties":{"Path":"$.longitude"},"column":"longitude","datatype":""},{"Properties":{"Path":"$.fault_type"},"column":"fault_type","datatype":""}]
