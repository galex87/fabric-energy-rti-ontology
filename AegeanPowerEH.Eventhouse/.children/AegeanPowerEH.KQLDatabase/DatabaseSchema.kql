.create-merge table GridTelemetry (timestamp:datetime, stream_type:string, grid_id:string, grid_name:string, frequency_hz:real, load_mw:real, generation_mw:real, voltage_kv:real, balance_mw:real) 
.create-or-alter table GridTelemetry ingestion json mapping 'AutoMapping'
