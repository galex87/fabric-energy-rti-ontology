table wind_turbines

	measure 'Turbine Count' = COUNTROWS(wind_turbines)
		formatString: #,##0

	measure 'Wind Capacity MW' = SUM(wind_turbines[capacity_mw])
		formatString: #,##0.0

	column turbine_id
		dataType: string
		isKey
		summarizeBy: none
		sourceColumn: turbine_id

	column turbine_name
		dataType: string
		summarizeBy: none
		sourceColumn: turbine_name

	column plant_id
		dataType: string
		summarizeBy: none
		sourceColumn: plant_id

	column manufacturer
		dataType: string
		summarizeBy: none
		sourceColumn: manufacturer

	column model
		dataType: string
		summarizeBy: none
		sourceColumn: model

	column capacity_mw
		dataType: double
		sourceColumn: capacity_mw

	column hub_height_m
		dataType: double
		sourceColumn: hub_height_m

	column rotor_diameter_m
		dataType: double
		sourceColumn: rotor_diameter_m

	column cut_in_speed_ms
		dataType: double
		sourceColumn: cut_in_speed_ms

	column rated_speed_ms
		dataType: double
		sourceColumn: rated_speed_ms

	column cut_out_speed_ms
		dataType: double
		sourceColumn: cut_out_speed_ms

	column latitude
		dataType: double
		sourceColumn: latitude

	column longitude
		dataType: double
		sourceColumn: longitude

	column commissioning_date
		dataType: string
		summarizeBy: none
		sourceColumn: commissioning_date

	column status
		dataType: string
		summarizeBy: none
		sourceColumn: status

	partition wind_turbines = entity
		mode: directLake
		source
			entityName: wind_turbines
			schemaName: dbo
			expressionSource: DL_Lakehouse

