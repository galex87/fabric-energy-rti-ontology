table power_plants

	measure 'Total Capacity MW' = SUM(power_plants[capacity_mw])
		formatString: #,##0.0

	column plant_id
		dataType: string
		isKey
		summarizeBy: none
		sourceColumn: plant_id

	column plant_name
		dataType: string
		summarizeBy: none
		sourceColumn: plant_name

	column plant_type
		dataType: string
		summarizeBy: none
		sourceColumn: plant_type

	column fuel_type
		dataType: string
		summarizeBy: none
		sourceColumn: fuel_type

	column capacity_mw
		dataType: double
		sourceColumn: capacity_mw

	column commissioning_year
		dataType: int64
		sourceColumn: commissioning_year

	column region
		dataType: string
		summarizeBy: none
		sourceColumn: region

	column prefecture
		dataType: string
		summarizeBy: none
		sourceColumn: prefecture

	column latitude
		dataType: double
		sourceColumn: latitude

	column longitude
		dataType: double
		sourceColumn: longitude

	column operator
		dataType: string
		summarizeBy: none
		sourceColumn: operator

	column status
		dataType: string
		summarizeBy: none
		sourceColumn: status

	column grid_zone
		dataType: string
		summarizeBy: none
		sourceColumn: grid_zone

	partition power_plants = entity
		mode: directLake
		source
			entityName: power_plants
			schemaName: dbo
			expressionSource: DL_Lakehouse

