table solar_inverters

	measure 'Inverter Count' = COUNTROWS(solar_inverters)
		formatString: #,##0

	measure 'Solar Capacity kW' = SUM(solar_inverters[capacity_kw])
		formatString: #,##0.0

	column inverter_id
		dataType: string
		isKey
		summarizeBy: none
		sourceColumn: inverter_id

	column inverter_name
		dataType: string
		summarizeBy: none
		sourceColumn: inverter_name

	column plant_id
		dataType: string
		summarizeBy: none
		sourceColumn: plant_id

	column manufacturer
		dataType: string
		summarizeBy: none
		sourceColumn: manufacturer

	column model
		dataType: string
		summarizeBy: none
		sourceColumn: model

	column capacity_kw
		dataType: double
		sourceColumn: capacity_kw

	column panel_type
		dataType: string
		summarizeBy: none
		sourceColumn: panel_type

	column panel_tilt_deg
		dataType: double
		sourceColumn: panel_tilt_deg

	column panel_azimuth_deg
		dataType: double
		sourceColumn: panel_azimuth_deg

	column latitude
		dataType: double
		sourceColumn: latitude

	column longitude
		dataType: double
		sourceColumn: longitude

	column commissioning_date
		dataType: string
		summarizeBy: none
		sourceColumn: commissioning_date

	column status
		dataType: string
		summarizeBy: none
		sourceColumn: status

	partition solar_inverters = entity
		mode: directLake
		source
			entityName: solar_inverters
			schemaName: dbo
			expressionSource: DL_Lakehouse

