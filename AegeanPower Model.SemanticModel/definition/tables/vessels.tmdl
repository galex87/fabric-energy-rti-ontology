table vessels

	column vessel_id
		dataType: string
		isKey
		summarizeBy: none
		sourceColumn: vessel_id

	column vessel_name
		dataType: string
		summarizeBy: none
		sourceColumn: vessel_name

	column vessel_type
		dataType: string
		summarizeBy: none
		sourceColumn: vessel_type

	column flag
		dataType: string
		summarizeBy: none
		sourceColumn: flag

	column imo_number
		dataType: string
		summarizeBy: none
		sourceColumn: imo_number

	column capacity_m3
		dataType: double
		sourceColumn: capacity_m3

	column current_cargo_m3
		dataType: double
		sourceColumn: current_cargo_m3

	column origin_port
		dataType: string
		summarizeBy: none
		sourceColumn: origin_port

	column origin_country
		dataType: string
		summarizeBy: none
		sourceColumn: origin_country

	column destination
		dataType: string
		summarizeBy: none
		sourceColumn: destination

	column speed_knots
		dataType: double
		sourceColumn: speed_knots

	column status
		dataType: string
		summarizeBy: none
		sourceColumn: status

	column supply_plant_id
		dataType: string
		lineageTag: c4f9af2f-45e0-413e-98e1-ecdf22b8875c
		sourceColumn: supply_plant_id

	partition vessels = entity
		mode: directLake
		source
			entityName: vessels
			schemaName: dbo
			expressionSource: DL_Lakehouse

